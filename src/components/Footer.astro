---
import { config } from '../config';

const socialLinks = [
  { name: 'GitHub', url: config.social.github, icon: 'fab fa-github' },
  { name: 'Discord', url: config.social.discord, icon: 'fab fa-discord' },
  { name: 'Bluesky', url: config.social.bluesky, icon: 'fas fa-cloud' },
  { name: 'YouTube', url: config.social.youtube, icon: 'fab fa-youtube' }
];
---

<footer>
  <div class="container">
    <div class="social-links">
      {socialLinks.map(link => (
        <a 
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <i class={link.icon}></i>
          <span class="sr-only">{link.name}</span>
        </a>
      ))}
    </div>
    <div class="copyright">
      <p>{new Date().getFullYear()} {config.name} &copy;. All rights reserved.</p>
    </div>
  </div>
</footer>